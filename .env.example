# API local
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Meta Graph API
# Nunca subas el token real al repositorio.
META_ACCESS_TOKEN=TU_TOKEN_META
# Varios Business Manager separados por coma.
META_BUSINESS_IDS=BUSINESS_ID_1,BUSINESS_ID_2,BUSINESS_ID_3
META_GRAPH_VERSION=v25.0
META_CACHE_TTL_SECONDS=300

# PostgreSQL local / Docker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_DB=finance_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_db?schema=public

# TRM USD/COP
# Histórico oficial publicado por la Superintendencia Financiera en Datos Abiertos Colombia.
TRM_HISTORICAL_URL=https://www.datos.gov.co/resource/32sa-8pi3.json
# Respaldo para la TRM vigente del día (no se usa como histórico).
TRM_CURRENT_URL=https://co.dolarapi.com/v1/trm
# Opcional: token de aplicación Socrata para mayores límites de consulta.
SOCRATA_APP_TOKEN=

# Proyección USD -> COP para conciliación bancaria
# Calibración inicial basada en cargos observados; no reemplaza la tasa real del banco.
USD_COP_EFFECTIVE_SPREAD_PERCENT=0.48
USD_COP_EFFECTIVE_SPREAD_MIN_PERCENT=0.44
USD_COP_EFFECTIVE_SPREAD_MAX_PERCENT=0.52
