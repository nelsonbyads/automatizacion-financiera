# Token de Acceso de Meta Graph API
# Debe tener permisos de lectura para las cuentas publicitarias (ads_read)
META_ACCESS_TOKEN=tu_token_aqui

# ID de Administrador Comercial (Business Manager ID) de Meta
BUSINESS_ID=tu_business_id_aqui

# Versión de la Graph API a consultar (por defecto v25.0)
GRAPH_VERSION=v25.0

# Mes a reportar (Formato YYYY-MM)
REPORT_MONTH=2026-08
